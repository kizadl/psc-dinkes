<IfModule mod_rewrite.c>
RewriteEngine on

RewriteRule ^login.html$ logout.php [L]
RewriteRule ^logout.html$ logout.php [L]
RewriteRule ^monitoring.html$ monitoring.php [L]
RewriteRule ^laporan.html$ laporan.php [L]
RewriteRule ^dashboard.html$ dashboard.php [L]
RewriteRule ^master.html$ master.php [L]
RewriteRule ^home.html$ logout.php [L]

</IfModule>

# secure htaccess file
<Files .htaccess>
order allow,deny
deny from all
#allow from env=ajax
</Files>

options All -Indexes